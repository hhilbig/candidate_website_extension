  "questions": [
    {
      "id": "identity_match",
      "label": "Does the evidence match the named candidate, mayoral office, and city?",
      "type": "yesno",
      "help": "Answer yes only when all three identity elements match."
    },
    {
      "id": "temporal_match",
      "label": "Does the evidence belong to this election cycle?",
      "type": "yesno",
      "help": "Current or later campaigns do not qualify."
    },
    {
      "id": "accept_url",
      "label": "Accept this as a candidate campaign URL claim?",
      "type": "yesno",
      "help": "Grades A through C can be accepted as claims. Only A and B are strict."
    },
    {
      "id": "url_type",
      "label": "URL type",
      "type": "select",
      "options": [
        "custom_domain",
        "candidate_subdomain",
        "shared_host_path",
        "fundraising_profile",
        "social_profile",
        "officeholder_site",
        "not_campaign_url"
      ]
    },
    {
      "id": "evidence_grade",
      "label": "Evidence grade",
      "type": "select",
      "options": [
        "A",
        "B",
        "C",
        "D",
        "reject"
      ]
    },
    {
      "id": "corrected_url",
      "label": "Corrected or recovered URL",
      "type": "text",
      "show_if": {
        "question": "accept_url",
        "equals": "yes"
      }
    }
  ]
